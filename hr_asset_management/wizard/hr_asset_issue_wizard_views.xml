<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_asset_issue_wizard_view_form" model="ir.ui.view">
        <field name="name">hr.asset.issue.wizard.form</field>
        <field name="model">hr.asset.issue.wizard</field>
        <field name="arch" type="xml">
            <form string="Issue Asset">
                <group>
                    <field name="equipment_id"/>
                    <field name="employee_id" widget="many2one_avatar_employee"/>
                    <field name="issue_date"/>
                    <field name="note" placeholder="Optional notes about this issue"/>
                </group>
                <footer>
                    <button name="action_confirm"
                        type="object"
                        string="Issue"
                        class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>

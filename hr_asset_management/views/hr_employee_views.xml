<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_employee_view_form_inherit_asset" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.asset</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_asset_issues"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-laptop">
                    <field name="asset_issue_count"
                        widget="statinfo"
                        string="Assets"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
